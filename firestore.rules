rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /aspirations/{document=**} {
      // 1. Read: Public can only read 'Approved' aspirations. Admin can read all.
      allow read: if request.auth != null || resource.data.status == 'Approved';
      // 2. Create: Only the Server can create (using the serverSecret) to enforce Rate Limit & Moderation
      allow create: if request.resource.data.serverSecret == 'osis_secure_2026';
      // 3. Update/Delete: Only Admin (authenticated via Firebase Auth)
      allow update, delete: if request.auth != null;
    }
    
    match /announcements/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
